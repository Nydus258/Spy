<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Sürüm, minSdk ve targetSdk build.gradle içinde. -->

    <!-- Hangi uygulamanın ne kadar kullanıldığını okumak için (kullanıcı Ayarlar'dan elle açar). -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <!-- Pomodoro / odak bildirimleri. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Tam zamanlı alarm izni istenmez: Pomodoro bildirimi sistemin izin verdiği en yakın anda gelir (Bridge.setAlarm). -->
    <!-- İnternet izni BİLEREK yok: veriler telefondan çıkamaz. Play Faturalandırma kütüphanesi bağımlılıkları üzerinden
         eklenen izinler aşağıda geri alınır; satın alma, Play Store uygulaması üzerinden yapılır. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- Android 11+: kullanılan uygulamaların adını okuyabilmek için. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33"
        android:theme="@style/SpyTheme">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|uiMode|smallestScreenSize|fontScale|locale|layoutDirection"
            android:exported="true"
            android:label="@string/launcher_name"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".AlarmReceiver" android:exported="false" />
    </application>
</manifest>
